# ------------------------------------------------------------------ Discord
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Right-click your server icon (with Developer Mode on) → Copy Server ID
GUILD_ID=
# Right-click each channel → Copy Channel ID
WELCOME_CHANNEL_ID=
# Private channel where officer-approval cases are posted.
REVIEW_CHANNEL_ID=
# Right-click each role → Copy Role ID
UNVERIFIED_ROLE_ID=
MEMBER_ROLE_ID=
GUEST_ROLE_ID=
OFFICER_ROLE_ID=

# Members channel for the "welcome, new member" post. Blank/0 = no announcement.
ANNOUNCE_CHANNEL_ID=

# --------------------------------------------------------------------- SMTP
# Gmail: 2-Step Verification must be on, then generate an *app password* at
# https://myaccount.google.com/apppasswords  (16 chars, spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
FROM_EMAIL=you@gmail.com
FROM_NAME=SREL Bot

# ------------------------------------------------------------ Google Sheets
# Sheet must have a header row with columns: callsign, full_name, email
GOOGLE_SHEET_ID=
# Path to the service account JSON key file. Share the sheet with the
# service account's email address (read-only is enough).
GOOGLE_SA_JSON=./service-account.json
ROSTER_SYNC_INTERVAL_MIN=60

# ---------------------------------------------------------------- Local DB
DB_PATH=./bot.db

# ---------------------------------------------------------------- Codes
CODE_TTL_MIN=15
CODE_RATE_LIMIT_PER_HOUR=3
