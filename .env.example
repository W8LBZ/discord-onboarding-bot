# ------------------------------------------------------------------ Discord
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Right-click your server icon (with Developer Mode on) → Copy Server ID
GUILD_ID=
# Right-click each channel → Copy Channel ID
WELCOME_CHANNEL_ID=
# Private officer-log channel: notes when someone verifies as an officer, and when a roster sync
# gives or removes the officer role. Blank/0 = no notes.
REVIEW_CHANNEL_ID=
# Right-click each role → Copy Role ID
UNVERIFIED_ROLE_ID=
MEMBER_ROLE_ID=
GUEST_ROLE_ID=
OFFICER_ROLE_ID=

# Members channel for the "welcome, new member" post. Blank/0 = no announcement.
ANNOUNCE_CHANNEL_ID=

# Rules channel linked in the welcome post and agreement prompts. Blank/0 = no link.
RULES_CHANNEL_ID=

# --------------------------------------------------------------------- SMTP
# Gmail: 2-Step Verification must be on, then generate an *app password* at
# https://myaccount.google.com/apppasswords  (16 chars, spaces optional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
FROM_EMAIL=you@gmail.com
FROM_NAME=SREL Bot

# ------------------------------------------------------------- Club roster
# The W8LBZ Minutes app's roster API (it replaced the Google Sheet), on the minutes container's LAN address.
# The app must list this container's IP in W8LBZ_ROSTER_API_ALLOW and have the same token in
# W8LBZ_ROSTER_API_TOKEN (both in /etc/w8lbz-minutes/env there).
ROSTER_API_URL=http://192.168.1.103:8000/api/roster
ROSTER_API_TOKEN=
ROSTER_SYNC_INTERVAL_MIN=60

# ---------------------------------------------------------------- Local DB
DB_PATH=./bot.db

# ---------------------------------------------------------------- Codes
CODE_TTL_MIN=15
CODE_RATE_LIMIT_PER_HOUR=3
